# Access Switch Audit — credential environment variables
#
# Copy this file to .env and fill in your values.
# The .env file is gitignored and never committed to version control.
#
# Variables already set in your shell environment always take precedence
# over values in this file.
#
# ── SSH credentials ───────────────────────────────────────────────────────────
SWITCH_USER=your_username
SWITCH_PASS=your_password

# ── Alternative credential variable names (also supported) ───────────────────
# CREDENTIAL_USER=your_username
# CREDENTIAL_PASS=your_password

# ── Windows Credential Manager target (optional override) ────────────────────
# Overrides credentials.target in config.yaml. CRED_TARGET is also accepted.
# CREDENTIAL_TARGET=SwitchAudit/User

# ── Jump host override (optional — overrides config.yaml) ────────────────────
# JUMP_HOST=192.0.2.1

# ── Enable secret (optional) ─────────────────────────────────────────────────
# Set USE_ENABLE=true and supply a secret only if your devices require
# 'enable' to reach privileged EXEC mode.
USE_ENABLE=false
# ENABLE_SECRET=your_enable_secret

# ── Other optional overrides ─────────────────────────────────────────────────
# Path to an alternative config.yaml
# SWITCH_AUDIT_CONFIG=/etc/switch-audit/config.yaml
# Directory for debug.log (default: ./logs)
# LOG_DIR=logs
# SSH connect timeout in seconds (overrides connection.timeout)
# CONNECTION_TIMEOUT=25

# ── SSH host key verification (overrides the security: section) ──────────────
# strict | auto-add | insecure
# SWITCH_AUDIT_HOST_KEY_POLICY=auto-add
# SWITCH_AUDIT_KNOWN_HOSTS=~/.ssh/known_hosts
